<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
	<PropertyGroup>
		<Version>0.0.0.0</Version>
		<LangVersion>preview</LangVersion>

		<Author>croizat</Author>
		<Name>SomethingNeedDoing</Name>
		<InternalName>SomethingNeedDoing</InternalName>
		<Punchline>Work work.</Punchline>
		<Description>Store unlimited macros and create lua scripts.</Description>
		<IconUrl>https://s3.puni.sh/media/plugin/34/icon-z405dwrdjem.png</IconUrl>
		<RepoUrl>https://github.com/Jaksuhn/SomethingNeedDoing</RepoUrl>
		<Tags>crafting;automation;lua;macros;scripting</Tags>
	</PropertyGroup>

	<PropertyGroup Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))'">
		<DalamudLibPath>$(DALAMUD_HOME)/</DalamudLibPath>
	</PropertyGroup>

	<ItemGroup>
	  <None Include="DalamudPackager.targets" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ECommons" Version="3.2.1.18" />
		<PackageReference Include="Injectio" Version="6.2.0">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
		<PackageReference Include="NLua" Version="1.7.9" />
		<PackageReference Include="Scrutor" Version="7.0.0" />
		<PackageReference Include="YamlDotNet" Version="18.1.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DalamudCodeEditor\DalamudCodeEditor.csproj" />
		<ProjectReference Include="..\AutoRetainerAPI\AutoRetainerAPI\AutoRetainerAPI.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Update="DotNet.ReproducibleBuilds" Version="2.0.5" />
	</ItemGroup>
</Project>